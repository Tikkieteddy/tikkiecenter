# News Risk Monitor

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_risk_monitor?schema=public"
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# OpenAI API ready. The current demo uses a local mock risk engine until a key is provided.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Email provider options: mock, smtp, resend, sendgrid
EMAIL_PROVIDER=mock
EMAIL_FROM="News Risk Monitor <no-reply@example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

RESEND_API_KEY=
SENDGRID_API_KEY=

# Mobile Web Push notification
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:editor@example.com

# Future-ready integrations
VECTOR_PROVIDER=pgvector
LINE_CHANNEL_ACCESS_TOKEN=
OCR_PROVIDER=
SPEECH_TO_TEXT_PROVIDER=
